# ==========================================================================
# Senha de administrador (login para editar a página)
# ==========================================================================
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório longo.
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="gere-um-segredo-aleatorio-longo"

# ==========================================================================
# Supabase (Postgres) — persistência do conteúdo em produção
# Sem estas variáveis, o app usa um arquivo local (.data/content.json) em dev.
# ==========================================================================
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# Service role key: usada SOMENTE no servidor para salvar o conteúdo.
SUPABASE_SERVICE_KEY="sua-service-role-key"

# ==========================================================================
# Cloudinary — upload/otimização de imagens e vídeos
# Sem estas variáveis, o modo de edição aceita colar a URL da mídia manualmente.
# ==========================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
CLOUDINARY_API_SECRET="sua-api-secret"
